{
  "typeCheckingMode": "off",
  "venvPath": ".",
  "venv": "venv",
  "extraPaths": [
    "./3_erp_project",
    "./3_erp_project/apps"
  ],
  "include": [
    "3_erp_project"
  ],
  "exclude": [
    "**/node_modules",
    "**/__pycache__",
    "venv"
  ],
  "reportMissingImports": "none",
  "reportMissingTypeStubs": false,
  "reportGeneralTypeIssues": "none",
  "reportOptionalMemberAccess": "none",
  "reportAttributeAccessIssue": "none"
}
