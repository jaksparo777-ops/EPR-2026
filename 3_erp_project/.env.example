# =========================================================
# FOUNDRY ERP - ENVIRONMENT CONFIGURATION TEMPLATE
# =========================================================

# Django Core Settings
SECRET_KEY=django-insecure-foundry-erp-secret-key-change-in-production
DEBUG=True
ALLOWED_HOSTS=*

# Dual Database Configuration
# Set USE_POSTGRES=True for multi-user production deployments
USE_POSTGRES=False

# PostgreSQL Connection Credentials (Used when USE_POSTGRES=True)
DB_NAME=foundry_erp
DB_USER=postgres
DB_PASSWORD=postgres
DB_HOST=localhost
DB_PORT=5432
